<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Ensure NuGet.org is available even if user/machine-level sources are empty -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>

